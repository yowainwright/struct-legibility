{
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": [
    "runtime/**/*.ts",
    "tests/fixtures/config/**/*.ts",
    "tests/fixtures/readme/**/*.ts",
    "tests/unit/**/*.ts"
  ]
}
